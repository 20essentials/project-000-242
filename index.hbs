<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UltraInstinto</title>
    <meta name="google" content="notranslate" />
    <link rel="shortcut icon" href="assets/favicon.webp" type="image/x-icon" />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <script id="ultrainstinto-template" type="text/x-handlebars-template">
      <div class="container">
        {{#each rings}}
          <div class="aro" style="--r: {{this}}"></div>
        {{/each}}
      </div>
    </script>

    <script>
      const source = document.getElementById("ultrainstinto-template").innerHTML;
      const template = Handlebars.compile(source);
      const data = {
        rings: Array.from({ length: 81 }, (_, i) => i + 1)
      };
      document.body.innerHTML = template(data);
    </script>
  </body>
</html>
